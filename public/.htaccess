# Web-root configuration.
#
# Two jobs only: route everything through the front controller when URL rewriting is
# available, and harden the directory. When rewriting is NOT available the application
# still works: links are generated as /index.php?r=/path, so no feature depends on
# mod_rewrite (ADR-0002).

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Do not rewrite real files or directories (static assets keep working).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Never execute anything inside the public tree except the front controller.
# (Uploaded files and generated assets live outside the web root; see the backend rule.)
<FilesMatch "\.(php|phtml|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<Files "index.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

# Directory listings are never helpful and can leak file names.
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
